{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Back: ejecutar suite completa",
      "type": "shell",
      "command": "mvn",
      "args": ["clean", "test"],
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Back: ejecutar pruebas de humo (@smoke)",
      "type": "shell",
      "command": "mvn",
      "args": ["clean", "test", "-Dkarate.options=--tags @smoke"],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Back: ejecutar casos negativos (@negativo)",
      "type": "shell",
      "command": "mvn",
      "args": ["clean", "test", "-Dkarate.options=--tags @negativo"],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Back: ejecutar en paralelo (3 hilos)",
      "type": "shell",
      "command": "mvn",
      "args": ["clean", "test", "-Dhilos=3"],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Back: abrir reporte",
      "type": "shell",
      "command": "open target/karate-reports/karate-summary.html",
      "windows": { "command": "start target\\karate-reports\\karate-summary.html" },
      "problemMatcher": []
    }
  ]
}
